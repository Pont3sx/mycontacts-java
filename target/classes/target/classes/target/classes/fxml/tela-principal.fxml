<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AgendaController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="top-bar" spacing="10">

            <TextField fx:id="campoBusca"
                       promptText="Buscar por nome..."
                       styleClass="campo-busca"
                       onKeyReleased="#onBuscar"
                       HBox.hgrow="ALWAYS"/>

            <Button text="＋ Adicionar"
                    styleClass="btn-adicionar"
                    onAction="#onAdicionar"/>

            <Button text="✕ Remover"
                    styleClass="btn-remover"
                    onAction="#onRemover"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tabelaContatos"
                   styleClass="tabela-contatos"
                   BorderPane.alignment="CENTER">
            <placeholder>
                <Label text="Nenhum contato cadastrado."/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colunaId"
                             text="ID"
                             prefWidth="50"/>
                <TableColumn fx:id="colunaNome"
                             text="Nome"
                             prefWidth="200"/>
                <TableColumn fx:id="colunaTelefone"
                             text="Telefone"
                             prefWidth="150"/>
                <TableColumn fx:id="colunaEmail"
                             text="E-mail"
                             prefWidth="250"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox styleClass="rodape" alignment="CENTER_RIGHT">
            <Label text="MyContacts v2 — Agenda de Contatos" styleClass="label-rodape"/>
        </HBox>
    </bottom>

</BorderPane>
